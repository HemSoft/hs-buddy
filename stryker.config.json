{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": true
  },
  "mutate": [
    "src/components/pr-threads/diffHunkUtils.ts",
    "src/utils/budgetUtils.ts",
    "src/utils/diffUtils.ts",
    "src/utils/dispatcherBackoff.ts",
    "src/utils/financeCalc.ts",
    "src/utils/githubUrl.ts",
    "src/utils/labelStyle.ts",
    "src/utils/networkSecurity.ts",
    "src/utils/prReviewEvents.ts",
    "src/utils/shortcutMatching.ts",
    "src/utils/taskGrouping.ts",
    "src/utils/toolCallParsing.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "concurrency": 2,
  "timeoutMS": 60000,
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "reporters": ["clear-text", "progress", "json", "html"],
  "clearTextReporter": {
    "logTests": false,
    "reportTests": false
  },
  "thresholds": {
    "high": 98,
    "low": 96.5,
    "break": 96.5
  }
}
