{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [],
  "workspaces": {
    ".": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "vitest.mutation.config.ts",
        "scripts/*.ts",
        "perf/*.ts",
        "generate-icons.ts",
        "convex/*.ts",
        "src/**/*.bench.ts",
        "src/features/*.steps.ts",
        "convex/**/*.bench.ts",
        "convex/__tests__/**/*.test.ts",
        "electron/**/*.bench.ts",
        "electron/**/*.test.ts",
        "perf/**/*.bench.ts",
        "perf/**/*.test.ts",
        "e2e/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "convex/**/*.ts",
        "shared/**/*.ts",
        "scripts/**/*.ts",
        "perf/**/*.ts",
        "*.ts"
      ]
    },
    "aspire-apphost": {
      "entry": ["apphost.mts"],
      "project": ["**/*.mts"]
    }
  }
}
