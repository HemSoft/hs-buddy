# pre-commit: validate FIRST, modify files LAST.
#
# Guarantees:
# - Phase 1 (validation) failures leave the index and worktree untouched by
#   this hook.
# - Phase 2 starts with formatting. lint-staged restores its own changes if a
#   formatting task fails. Once formatting has succeeded, a later phase-2
#   failure aborts the commit but may leave reformatted staged files and
#   generated files in place; recover with
#   `git restore --staged --worktree .` if unwanted.
# - The revision bump restores package.json itself when it fails, so the most
#   common late generator failure strands nothing.

set -e

# --- PHASE 1: Validation (read-only, no file modifications) ---

# copilot-hooks:begin markdown gate
# Block commits on markdownlint violations for staged .md files
MARKDOWN_HOOK="$(git rev-parse --git-common-dir)/hooks/pre-commit-markdown.ps1"
if [ -f "$MARKDOWN_HOOK" ]; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$MARKDOWN_HOOK"
else
  echo "Missing $MARKDOWN_HOOK. Reinstall copilot-hooks."
  exit 1
fi
# copilot-hooks:end markdown gate

# Block commits when tests fail or coverage drops below threshold
bun run test:coverage

# Block commits when the repo has TypeScript errors
bun run typecheck

# --- PHASE 2: File modifications (only reached if ALL validation passed) ---

# Format and lint staged files. lint-staged restores its own changes if one of
# these tasks fails, and it is intentionally deferred until tests and
# typechecking have passed.
npx lint-staged

# Ratchet coverage thresholds up (never down)
bun run coverage:ratchet

# Auto-bump revision: package.json only (renderer reads from appVersion.ts)
# Snapshot package.json so a failed bump cannot strand half-applied mutations.
BUMP_SNAPSHOT="$(mktemp "${TMPDIR:-/tmp}/hs-buddy-pre-commit-pkg.XXXXXX")"
cp package.json "$BUMP_SNAPSHOT"
bump_status=0
bun scripts/bump-revision.ts || bump_status=$?
if [ "$bump_status" -ne 0 ]; then
  cp "$BUMP_SNAPSHOT" package.json
  rm -f "$BUMP_SNAPSHOT"
  echo "pre-commit: bump-revision failed; package.json restored to its pre-bump content" >&2
  exit "$bump_status"
fi
rm -f "$BUMP_SNAPSHOT"

# Stage all auto-generated files so they're included in this commit
# (git add in pre-commit IS included in the commit — verified)
git add vitest.config.ts package.json
